# .env.example - Copier en .env et remplir avec les vraies valeurs sur PythonAnywhere

# Django Secret Key (générer une nouvelle clé sécurisée)
# Utiliser: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-key-here-change-me

# Mode Debug (False pour production)
DEBUG=False

# Hosts autorisés (séparés par des virgules)
ALLOWED_HOSTS=jonathan16.pythonanywhere.com,localhost,127.0.0.1

# Database (laisser vide pour SQLite par défaut)
# DATABASE_URL=postgresql://user:password@localhost/dbname
# (Si vous migrez à PostgreSQL plus tard)

# Email (optionnel pour notifications)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# Sécurité additionnelle
# CSRF_TRUSTED_ORIGINS=https://jonathan16.pythonanywhere.com
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
